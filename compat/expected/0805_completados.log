. clear

. set seed 805

. set obs 200
number of observations (_N) was 0, now 200

. gen id = ceil(_n/5)

. gen t = mod(_n-1, 5) + 1

. xtset id t
       panel variable:  id (strongly balanced)
        time variable:  t, 1 to 5
                delta:  1 unit

. gen x = round(invnormal(runiform()), .01)

. gen u = (mod(id, 7) - 3)/3

. gen y = 1 + .5*x + u + round(invnormal(runiform()), .01)

. gen yb = runiform() < invlogit(-.3 + .8*x + u)

. gen yc = floor(exp(.2 + .3*x + .5*u) * runiform()*2)

