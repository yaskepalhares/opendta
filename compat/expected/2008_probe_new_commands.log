. display "=== which command widens the format of a labeled variable"
=== which command widens the format of a labeled variable

. clear

. set obs 6
number of observations (_N) was 0, now 6

. gen g = mod(_n,3)

. gen id = _n

. label define lg 0 "zero com texto bem comprido para testar quebra" 1 "um" 2 "dois"

. describe g

              storage   display    value
variable name   type    format     label      variable label
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
g               float   %9.0g                 

. label values g lg

. describe g

              storage   display    value
variable name   type    format     label      variable label
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
g               float   %46.0g     lg         

. compress
  variable g was float now byte
  variable id was float now byte
  (36 bytes saved)

. describe g

              storage   display    value
variable name   type    format     label      variable label
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
g               byte    %46.0g     lg         

. save "odta_probe_fmt.dta", replace
(note: file odta_probe_fmt.dta not found)
file odta_probe_fmt.dta saved

. use "odta_probe_fmt.dta", clear

