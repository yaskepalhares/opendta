. * Funções de string. Para concatenar no display é preciso usar parênteses:
. * uma string entre aspas no início de uma diretiva é texto literal.
. capture noisily display "a" + "b"
a+"b" invalid name

. display ("a" + "b")
ab

. display ("ab" * 3)
ababab

. display strlen("abc")
3

. display length("abc")
3

. display upper("Abc") lower("ABC") proper("joão da silva")
ABCabcJoãO Da Silva

. display substr("abcdef", 2, 3)
bcd

. display substr("abcdef", -2, .)
ef

. display substr("abcdef", 10, 2) "|"
|

. display strpos("abcabc", "c")
3

. display subinstr("aaa", "a", "b", 2)
bba

. display subinstr("aaa", "a", "b", .)
bbb

. display subinword("a b a b", "a", "x", .)
x b x b

. display word("um dois tres", 2)
dois

. display word("um dois tres", -1)
tres

. display wordcount("  um   dois  ")
2

. display trim("  x  ") "|"
x|

. display ltrim("  x  ") "|"
x  |

. display itrim("a    b")
a b

. display reverse("abc")
cba

. display real("1.5") + 1
2.5

. display real("abc")
.

. display strmatch("abc", "a*")
1

. display strmatch("abc", "?b?")
1

. display regexm("abc123", "[0-9]+")
1

. display regexs(0)
123

. display regexr("abc123", "[0-9]+", "X")
abcX

. display ("abc" < "abd")
1

. display ("B" < "a")
1

. display abbrev("variavel_muito_longa", 10)
variavel~a

. display inlist("b", "a", "b")
1

. 
