. * -- classutil ([P] classutil)
. .coord = .oc_coord.new 1 2

. .li = .oc_line.new

. .n1 = 3

. .s1 = "text"

. capture noisily classutil dir
.coord  .li     .n1     .s1

. capture noisily classutil dir, detail
oc_coord     .coord
oc_line      .li
double       .n1            = 3
string       .s1            = "text"

. capture noisily classutil dir c*
.coord

. return list

macros:
               r(list) : ".coord"

. capture noisily classutil describe .coord

oc_coord .coord:
        double       .x             = 1
        double       .y             = 2

. return list

macros:
             r(bitype) : "instance"
               r(type) : "oc_coord"

. capture noisily classutil describe .li, recurse

oc_line .li:
        oc_coord     .c0
        oc_coord     .c1

oc_coord .li.c0:
        double       .x             = .
        double       .y             = .

oc_coord .li.c1:
        double       .x             = .
        double       .y             = .

