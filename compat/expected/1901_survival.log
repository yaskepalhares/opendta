. gen id = _n

. gen g = ceil(_n/4)

. gen x = mod(_n*7,11)/5 - 1

. gen byte grp = 1 + mod(_n,3)

. gen byte trt = mod(_n,2)

. gen double t = 1 + round(2*12*(-ln((mod(_n*37,61)+.5)/61))*exp(.4*x))/2

. gen byte ev = mod(_n,5) != 0

. replace ev = 2 if ev == 1 & mod(_n,7) == 0
