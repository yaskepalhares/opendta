. * Phase 19: panel data (random-effects models by quadrature, linear panel estimators, frontier,
. * unit-root tests, dynamic panel GMM and panel description). Every command runs under capture
. * noisily so that a difference in one command does not stop the rest of the case; the layouts
. * marked VERIFY in the code are settled by the reference log.
. * The data are built from rounded draws, so that the last digit of the draws does not matter.
. program define mkpanel
  1.     clear
  2.     set seed 1905
  3.     set obs 480
  4.     gen int id = ceil(_n/8)
  5.     gen int t = _n - (id-1)*8 + 1999
  6.     xtset id t
  7.     gen double u = round(invnormal(runiform()), .01)
  8.     bysort id (t): replace u = u[1]
  9.     gen double e = round(invnormal(runiform()), .01)
 10.     gen double x1 = round(invnormal(runiform()), .01)
 11.     gen double z = round(invnormal(runiform()), .01)
 12.     gen double x2 = round(.5*z + invnormal(runiform()) + .5*u, .01)
 13.     gen double w = round(id/20, .01)
 14.     gen double y = round(1 + .5*x1 + .3*x2 + .2*w + u + e, .01)
 15.     gen byte yb = runiform() < invlogit(-.2 + .8*x1 + .7*u)
 16.     gen double lat = round(.5*x1 + .6*u + e, .01)
 17.     gen byte yo = (lat > -.4) + (lat > .6)
 18.     gen double yt = max(0, lat)
 19.     gen double ylo = floor(lat)
 20.     gen double yhi = ylo + 1
 21.     gen double yc = floor(-ln(runiform()) * exp(.3*x1 + .5*u) * 3)
 22.     gen double ly = round(1 + .5*x1 + .3*x2 + .3*e - .3*abs(invnormal(runiform())), .01)
 23. end

. 
. program define mkroot
  1.     clear
  2.     set seed 19051
  3.     set obs 360
  4.     gen int id = ceil(_n/30)
  5.     gen int t = _n - (id-1)*30
  6.     xtset id t
  7.     gen double e = round(invnormal(runiform()), .01)
  8.     gen double rw = e
  9.     bysort id (t): replace rw = round(rw[_n-1] + e, .01) if _n > 1
 10.     gen double st = e
 11.     bysort id (t): replace st = round(.5*st[_n-1] + e, .01) if _n > 1
 12. end

. 
. program define mkdyn
  1.     clear
  2.     set seed 19052
  3.     set obs 1200
  4.     gen int id = ceil(_n/6)
  5.     gen int t = _n - (id-1)*6
  6.     xtset id t
  7.     gen double u = round(invnormal(runiform()), .01)
  8.     bysort id (t): replace u = u[1]
  9.     gen double x = round(invnormal(runiform()), .01)
 10.     gen double w = round(invnormal(runiform()), .01)
 11.     gen double y = round(u + x + invnormal(runiform()), .01)
 12.     bysort id (t): replace y = round(.5*y[_n-1] + x + .3*w + u + invnormal(runiform()), .01) if _n > 1
 13. end

. 
. * ---- random effects by quadrature
