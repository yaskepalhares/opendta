. * Phase 18: time series (data tools, filters and smoothers, spectral analysis, unit-root tests,
. * prais, VAR postestimation, vec, svar, irf extensions, arch, arfima, arima extensions,
. * state-space models and mgarch). Every command runs under capture noisily so that a difference
. * in one command does not stop the rest of the case; the layouts marked VERIFY in the code are
. * settled by the reference log.
. * The data are built from rounded draws, so that the last digit of the draws does not matter.
. program define mkts
  1.     clear
  2.     set seed 1904
  3.     set obs 160
  4.     gen int t = _n + 599
  5.     format t %tm
  6.     tsset t
  7.     gen double e1 = round(invnormal(runiform()), .01)
  8.     gen double e2 = round(invnormal(runiform()), .01)
  9.     gen double e3 = round(invnormal(runiform()), .01)
 10.     gen double x = round(invnormal(runiform()), .01)
 11.     gen double w = round(sum(e3), .01)
 12.     gen double c1 = round(w + .5*e1, .01)
 13.     gen double c2 = round(.5*w + .5*e2, .01)
 14.     gen double y = 0
 15.     gen double z = 0
 16.     forvalues i = 2/160 {
 17.         quietly replace y = round(.5*y[`i'-1] + .2*z[`i'-1] + e1, .01) in `i'
 18.         quietly replace z = round(.1*y[`i'-1] + .4*z[`i'-1] + e2, .01) in `i'
 19.     }
 20.     gen double u = 0
 21.     forvalues i = 2/160 {
 22.         quietly replace u = round(.6*u[`i'-1] + e3 + .3*e3[`i'-1], .01) in `i'
 23.     }
 24.     gen double r = round(2 + .5*x + u, .01)
 25.     * GARCH(1,1) series
.     gen double h = 1
 26.     gen double g = 0
 27.     forvalues i = 2/160 {
 28.         quietly replace h = .2 + .2*g[`i'-1]^2 + .5*h[`i'-1] in `i'
 29.         quietly replace g = round(sqrt(h)*e1, .01) in `i'
 30.     }
 31.     * GARCH(1,1) series with a shock correlated with e1
.     gen double h2 = 1
 32.     gen double g2 = 0
 33.     forvalues i = 2/160 {
 34.         quietly replace h2 = .1 + .2*g2[`i'-1]^2 + .6*h2[`i'-1] in `i'
 35.         quietly replace g2 = round(sqrt(h2)*(.5*e1 + .87*e2), .01) in `i'
 36.     }
 37.     * seasonal series (quarterly pattern)
.     gen double sa = round(10 + 2*mod(_n, 4) + .1*_n + e2, .01)
 38.     * the series below are for the commands that need data with the feature they estimate
.     * fat-tailed GARCH(1,1) series (arch with t errors, egarch)
.     gen double eh = round(e1*(1 + 2*(e3 > 1.2)), .01)
 39.     gen double hh0 = 1
 40.     gen double gt = 0
 41.     forvalues i = 2/160 {
 42.         quietly replace hh0 = .2 + .2*gt[`i'-1]^2 + .5*hh0[`i'-1] in `i'
 43.         quietly replace gt = round(sqrt(hh0)*eh, .01) in `i'
 44.     }
 45.     * cycle (AR(2) with complex roots)
.     gen double cy = 0
 46.     forvalues i = 3/160 {
 47.         quietly replace cy = round(1.2*cy[`i'-1] - .6*cy[`i'-2] + e2, .01) in `i'
 48.     }
 49.     * local linear trend plus noise
.     gen double lv = 0
 50.     gen double sl = 0
 51.     forvalues i = 2/160 {
 52.         quietly replace sl = sl[`i'-1] + .1*e2 in `i'
 53.         quietly replace lv = lv[`i'-1] + sl[`i'-1] + .3*e1 in `i'
 54.     }
 55.     gen double tr = round(lv + e3, .01)
 56.     * stochastic seasonal series
.     gen double ss = 0
 57.     forvalues i = 5/160 {
 58.         quietly replace ss = round(ss[`i'-4] + e1 + .5*e1[`i'-4], .01) in `i'
 59.     }
 60.     * two series whose correlation moves (dynamic conditional correlation)
.     gen double q11 = 1
 61.     gen double q12 = .4
 62.     gen double q22 = 1
 63.     gen double z1 = 0
 64.     gen double z2 = 0
 65.     gen double hd1 = 1
 66.     gen double hd2 = 1
 67.     gen double d1 = 0
 68.     gen double d2 = 0
 69.     forvalues i = 2/160 {
 70.         local j = `i' - 1
 71.         quietly replace q11 = .05 + .15*z1[`j']^2 + .8*q11[`j'] in `i'
 72.         quietly replace q12 = .02 + .15*z1[`j']*z2[`j'] + .8*q12[`j'] in `i'
 73.         quietly replace q22 = .05 + .15*z2[`j']^2 + .8*q22[`j'] in `i'
 74.         quietly replace z1 = e1 in `i'
 75.         quietly replace z2 = q12/sqrt(q11*q22)*e1 + sqrt(1 - q12^2/(q11*q22))*e2 in `i'
 76.         quietly replace hd1 = .1 + .2*d1[`j']^2 + .6*hd1[`j'] in `i'
 77.         quietly replace hd2 = .15 + .25*d2[`j']^2 + .5*hd2[`j'] in `i'
 78.         quietly replace d1 = round(sqrt(hd1)*z1, .01) in `i'
 79.         quietly replace d2 = round(sqrt(hd2)*z2, .01) in `i'
 80.     }
 81. end

. set more off

. set linesize 255

. mkts
number of observations (_N) was 0, now 160
        time variable:  t, 2010m1 to 2023m4
                delta:  1 month

. 
