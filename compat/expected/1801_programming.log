. * program, sortpreserve
. clear

. set obs 6
number of observations (_N) was 0, now 6

. gen x = 7 - _n

. gen y = _n

. sort y

. capture program drop odta_mysort

. program define odta_mysort, sortpreserve
  1.     sort x
  2.     display "inside: `_sortindex'"
  3.     list y, noobs clean
  4. end

