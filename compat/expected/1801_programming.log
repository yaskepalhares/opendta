. * postfile
. set seed 12345

. capture program drop odta_lnsim

. program odta_lnsim
  1.     version 14
  2.     tempname sim
  3.     postfile `sim' mean var using odta_results, replace
  4.     quietly {
  5.         forvalues i = 1/20 {
  6.             drop _all
  7.             set obs 100
  8.             generate z = exp(rnormal())
  9.             summarize z
 10.             post `sim' (r(mean)) (r(Var))
 11.         }
 12.     }
 13.     postclose `sim'
 14. end

