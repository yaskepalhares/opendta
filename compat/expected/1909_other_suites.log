. 
. * ---- irt: six binary items and four items with four ordered categories
. clear

. set seed 190902

. set obs 800
number of observations (_N) was 0, now 800

. gen double th = round(invnormal(runiform()), .01)

. gen byte q1 = runiform() < invlogit(1*(th + 1))

. gen byte q2 = runiform() < invlogit(1.4*(th + .4))

. gen byte q3 = runiform() < invlogit(.8*(th - 0))

. gen byte q4 = runiform() < invlogit(1.2*(th - .6))

. gen byte q5 = runiform() < invlogit(1.6*(th - 1))

. gen byte q6 = runiform() < invlogit(1.2*(th - .2))

. forvalues j = 1/6 {
  2.     * two draws in separate variables, so that no logical operator decides whether a draw is made
.     gen double ug = runiform()
  3.     gen double uh = runiform()
  4.     gen byte g`j' = ug < .2 | uh < invlogit((.6 + .2*`j')*(th - 1.2 + .4*`j'))
  5.     drop ug uh
  6. }

. forvalues j = 1/4 {
  2.     gen double us = runiform()
  3.     gen double s`j' = (.8 + .2*`j')*th + ln(us/(1 - us))
  4.     gen byte r`j' = (s`j' > -1.6 + .2*`j') + (s`j' > -.2 + .2*`j') + (s`j' > 1.2 + .2*`j')
  5.     * dropped so that r1-r4 holds only the items
.     drop s`j' us
  6. }

