. * Phase 17: base statistics (resampling, ml, model building, postestimation, tests, agreement,
. * transformations and displays). Every command runs under capture noisily so that a difference
. * in one command does not stop the rest of the case; the layouts marked VERIFY in the code are
. * settled by the reference log.
. * Stata's example datasets are not available in OpenDTA, so the case builds its own data.
. * Everything is rounded to integers (or cents), so that the last digit of the draws does not matter.
. program define mkdata
  1.     clear
  2.     set seed 1903
  3.     set obs 74
  4.     gen int weight = round(3000 + 700*invnormal(runiform()))
  5.     gen int length = round(weight/17 + 4*invnormal(runiform()))
  6.     gen byte rep78 = 1 + floor(5*runiform())
  7.     gen int mpg = max(12, round(40 - weight/110 + rep78 + 2.5*invnormal(runiform())))
  8.     gen int displacement = round(weight/12 + 30*invnormal(runiform()))
  9.     gen int turn = round(length/5 + 2*invnormal(runiform()))
 10.     gen byte foreign = runiform() < 1/(1 + exp((weight - 2800)/400))
 11.     gen int price = round(exp(7.8 + .00025*weight - .01*mpg + .35*invnormal(runiform())))
 12.     replace rep78 = . if runiform() < .07
 13.     label variable mpg "Mileage (mpg)"
 14. end

. set more off

. mkdata
number of observations (_N) was 0, now 74
(7 real changes made, 7 to missing)

. gen hiprice = price > 6000

. gen hiwt = weight > 3000

. gen double lnprice0 = ln(price)

. 
