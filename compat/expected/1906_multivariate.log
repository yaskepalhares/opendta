. * Phase 20: multivariate statistics (principal components, factor analysis and rotation, scale
. * reliability, multivariate tests and models, cluster analysis, discriminant analysis, correspondence
. * analysis, multidimensional scaling, procrustes analysis and biplots). Every command runs under
. * capture noisily so that a difference in one command does not stop the rest of the case; the
. * layouts marked VERIFY in the code are settled by the reference log.
. * The data are built from rounded draws, so that the last digit of the draws does not matter.
. program define mkmv
  1.     clear
  2.     set seed 1906
  3.     set obs 150
  4.     gen int id = _n
  5.     gen byte g = ceil(3*runiform())
  6.     gen byte g2 = 1 + (runiform() < .5)
  7.     gen double f1 = round(invnormal(runiform()), .01)
  8.     gen double f2 = round(invnormal(runiform()), .01)
  9.     gen double x1 = round(.8*f1 + .6*invnormal(runiform()) + .6*g, .01)
 10.     gen double x2 = round(.7*f1 + .7*invnormal(runiform()) - .4*g, .01)
 11.     gen double x3 = round(.6*f1 + .8*invnormal(runiform()) + .3*g, .01)
 12.     gen double x4 = round(.8*f2 + .6*invnormal(runiform()), .01)
 13.     gen double x5 = round(.7*f2 + .7*invnormal(runiform()), .01)
 14.     gen double x6 = round(.6*f2 + .8*invnormal(runiform()), .01)
 15.     gen double y1 = round(1 + .5*x1 + .3*x4 + invnormal(runiform()), .01)
 16.     gen double y2 = round(.5*x2 - .4*x5 + invnormal(runiform()), .01)
 17.     gen double y3 = round(.3*x3 + .2*g + invnormal(runiform()), .01)
 18.     gen byte a = ceil(3*runiform())
 19.     gen byte b = ceil(4*runiform())
 20.     replace b = a if runiform() < .4
 21.     gen byte c = ceil(2*runiform())
 22.     replace c = 1 if a == 1 & runiform() < .5
 23. end

