. gen id = ceil(_n/20)

. gen t = mod(_n-1,20)+1

. xtset id t
       panel variable:  id (strongly balanced)
        time variable:  t, 1 to 20
                delta:  1 unit

. gen e = round(invnormal(runiform()), .01)

. gen y = e

. sort id t, stable

. by id: replace y = .5*y[_n-1] + e if _n > 1
