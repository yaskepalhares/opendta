. * Phase 21: models, part 1 (binary and fractional response, count data, censored, truncated and
. * selection models, models with endogenous regressors). Every command runs under capture noisily so
. * that a difference in one command does not stop the rest of the case; the layouts marked VERIFY in
. * the code are settled by the reference log. The data are built from rounded draws and from comparisons
. * of runiform() draws (counts are sums of Bernoulli draws, because rpoisson() and rbinomial() do not
. * reproduce Stata's draws), so that the last digit of the draws does not matter.
. program define mkmod
  1.     clear
  2.     set seed 1907
  3.     set obs 600
  4.     gen int id = _n
  5.     gen byte g = ceil(3*runiform())
  6.     gen double x1 = round(invnormal(runiform()), .01)
  7.     gen double x2 = round(invnormal(runiform()), .01)
  8.     gen double x3 = round(.5*x1 + invnormal(runiform()), .01)
  9.     gen double u = round(invnormal(runiform()), .01)
 10.     gen double xs = round(runiform() - .5, .01)
 11.     gen double ystar = round(.3 + .8*x1 - .5*x2 + u, .01)
 12.     gen byte yb = ystar > 0
 13.     gen byte yb2 = (.2 - .6*x1 + .5*x3 + round(invnormal(runiform()), .01)) > 0
 14.     gen double mu = exp(.4 + .3*x1 - .2*x2)
 15.     gen int cnt = 0
 16.     forvalues j = 1/40 {
 17.         replace cnt = cnt + (runiform() < mu/40)
 18.     }
 19.     gen double mu2 = exp(.6 + .3*x1)
 20.     gen int cnt2 = 0
 21.     forvalues j = 1/40 {
 22.         replace cnt2 = cnt2 + (runiform() < mu2/40)
 23.     }
 24.     replace cnt2 = 0 if runiform() < .3 + .2*(x2 > 0)
 25.     gen int ctr = cnt if cnt > 0
 26.     gen double yfr = invlogit(.2 + .5*xs*2 - .3*x2 + .3*u)
 27.     replace yfr = round(yfr, .001)
 28.     gen byte yr = runiform() < invlogit(-1 + .4*xs)
 29.     gen byte yrr = runiform() < .2 + .3*xs
 30.     gen double yc = round(1 + .7*x1 + .5*x2 + 1.2*u, .01)
 31.     gen double ylo = floor(yc)
 32.     gen double yhi = ceil(yc)
 33.     replace ylo = . if yc < -1
 34.     replace yhi = . if yc > 3
 35.     replace yhi = yhi + 1 if ylo == yhi & !missing(yhi)
 36.     gen double yt = yc if yc > -1
 37.     gen byte sel = (.3 + .6*x1 + .7*x3 + round(invnormal(runiform()), .01)) > 0
 38.     gen double ysel = round(1 + .8*x2 + .6*u + .6*round(invnormal(runiform()), .01), .01) if sel
 39.     gen byte ysb = (.2 + .5*x2 + .5*u + .6*round(invnormal(runiform()), .01)) > 0 if sel
 40.     gen double z1 = round(invnormal(runiform()), .01)
 41.     gen double z2 = round(invnormal(runiform()), .01)
 42.     gen double v = round(.5*u + .8*invnormal(runiform()), .01)
 43.     gen double w2 = round(.6*z1 + .4*z2 + .3*x1 + v, .01)
 44.     gen double yiv = round(1 + .7*w2 + .4*x1 + u, .01)
 45.     gen byte yivb = yiv > 1.5
 46.     gen double yivt = max(yiv, 0)
 47.     gen double muc = exp(.2 + .3*w2 + .2*x1 + .3*u)
 48.     gen int yivc = 0
 49.     forvalues j = 1/40 {
 50.         replace yivc = yivc + (runiform() < muc/40)
 51.     }
 52. end

. 
. * ---- binary and fractional response
. mkmod
