. * Macros locais e globais.
. local a hello

. local b "hello world"

. local c `"com "aspas" dentro"'

. display "`a'"
hello

. display "`b'"
hello world

. display `"`c'"'
com "aspas" dentro

. global g 7

. display $g + ${g}
14

. local i 2

. local v2 segundo

. display "`v`i''"
segundo

. local n 1

. display `++n'
2

. display `n'
2

. local m 5

. display `m--'
5

. display `m'
4

. local ++n

. display `n'
3

. local --n

. display `n'
2

. display "[`naoexiste']"
[]

. display "`=2*21'"
42

. local w : word count a "b c" d

. display `w'
3

. local w2 : word 2 of a b c

. display "`w2'"
b

. local f : display %5.2f 1/3

. display "[`f']"
[ 0.33]

. local lista1 x y z

. local lista2 y z w

. local u : list lista1 | lista2

. display "`u'"
x y z w

. local d : list lista1 - lista2

. display "`d'"
x

. local s : list sizeof lista1

. display `s'
3

. tokenize "um dois tres"

. display "`1' `3'"
um tres

. tokenize "a,b,c", parse(",")

. display "`1'|`2'|`3'|`5'"
a|,|b|c

. 
